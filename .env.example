# AI Squad — Environment Variables
# Copy to .env and fill in real values
# Never commit .env to git

# ── Postgres Owner Role ───────────────────────────────
# Used by the postgres container and migration/bootstrap tooling.
POSTGRES_USER=squad
POSTGRES_PASSWORD=changeme-local
POSTGRES_DB=squad

# ── App Database Role ─────────────────────────────────
# Used by control-api at runtime. This role should not own schema objects.
APP_DB_USER=squad_app
APP_DB_PASSWORD=squadapp-local

# ── Redis ─────────────────────────────────────────────
# (no auth needed for local dev)

# ── Ollama ────────────────────────────────────────────
# No credentials needed for local Ollama

# ── Control API ───────────────────────────────────────
SECRET_KEY=changeme-generate-a-real-random-secret
LOG_LEVEL=INFO
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://squad_app:squadapp-local@localhost:5432/squad

# ── Admin Web ─────────────────────────────────────────
API_URL=http://localhost:8000
NODE_ENV=development

# ── GitHub App ────────────────────────────────────────
# Create a GitHub App at: https://github.com/settings/apps/new (personal)
# or: https://github.com/organizations/{org}/settings/apps/new (org)
#
# Required permissions (see docs/BASE_OPERATING_SPEC.md section 5):
#   - Contents: write
#   - Issues: write
#   - Pull Requests: write
#   - Checks: write
#   - Projects: write (for M6)
#   - Metadata: read
#
# After creating the app:
# 1. Install it on your test repo
# 2. Note the App ID (shown on app settings page)
# 3. Note the Installation ID (from: GET https://api.github.com/app/installations)
# 4. Generate + download a private key (.pem)
# 5. Place the .pem at: infra/secrets/github-app.pem
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Path inside the container (do not change unless you move the secrets volume)
GITHUB_APP_PRIVATE_KEY_PATH=/secrets/github-app.pem

# ── Test GitHub Repo ──────────────────────────────────
# Used only for integration tests — separate from your real project repo
GITHUB_TEST_REPO_ORG=
GITHUB_TEST_REPO_NAME=ai-squad-test-workspace
